# ── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.Python
pip-wheel-metadata/

# ── Virtual environments ─────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Model checkpoints (large binary files) ───────────────────────────────────
models/*.pth
models/*.pt
models/*.ckpt
models/training_history.json
models/checkpoint_last.pth
models/best_model.pth

# ── Dataset (never commit patient data) ──────────────────────────────────────
dataset/

# ── Generated reports (contain analysis outputs, possibly sensitive) ─────────
reports/*.json
reports/*.html
reports/*.png
reports/*.pdf

# ── Coverage & test artifacts ─────────────────────────────────────────────────
.coverage
coverage_html/
.pytest_cache/
htmlcov/
*.coverage

# ── Jupyter ──────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── macOS ────────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
._*

# ── IDEs ─────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── Temp / uploads ───────────────────────────────────────────────────────────
tmp/
temp/
uploads/

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
